import json
import os

from flask import Flask, jsonify, render_template, request

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
STATE_FILE = os.path.join(BASE_DIR, "state.json")

DEFAULTS = {"AIM": False, "ESP": False, "M1": False, "INJECTION": False}
# Visual placeholder only: can never be switched on.
LOCKED = {"INJECTION"}

app = Flask(__name__)


def load_state():
    state = dict(DEFAULTS)
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict):
            for key in DEFAULTS:
                if key in data:
                    state[key] = bool(data[key])
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass
    for key in LOCKED:
        state[key] = False
    return state


def save_state(state):
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE_FILE)


@app.route("/")
def index():
    return render_template("index.html", state=load_state())


@app.route("/api/state", methods=["GET"])
def api_state():
    return jsonify(load_state())


@app.route("/api/toggle", methods=["POST"])
def api_toggle():
    data = request.get_json(silent=True) or {}
    key = data.get("key")
    if key not in DEFAULTS:
        return jsonify({"error": "Unknown key"}), 400
    if key in LOCKED:
        return jsonify({"error": "This toggle is a disabled placeholder"}), 403

    state = load_state()
    value = data.get("value")
    if value is None:
        state[key] = not state[key]
    elif isinstance(value, bool):
        state[key] = value
    else:
        return jsonify({"error": "value must be true or false"}), 400

    save_state(state)
    return jsonify(state)


@app.route("/api/reset", methods=["POST"])
def api_reset():
    state = dict(DEFAULTS)
    save_state(state)
    return jsonify(state)


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=False)
