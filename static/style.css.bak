:root {
  --bg: #07060f;
  --card: rgba(255, 255, 255, 0.05);
  --border: rgba(255, 255, 255, 0.12);
  --text: #e8e6ff;
  --muted: #8f8bb3;
  --neon: #00f0ff;
  --neon2: #ff2bd6;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 24px 16px;
  overflow-x: hidden;
}

.bg-glow {
  position: fixed;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  filter: blur(110px);
  opacity: 0.35;
  z-index: 0;
  pointer-events: none;
}
.g1 { background: var(--neon); top: -140px; left: -140px; }
.g2 { background: var(--neon2); bottom: -160px; right: -140px; }

.panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 460px;
  padding: 26px 22px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 22px;
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 0 0 1px rgba(0, 240, 255, 0.08),
              0 20px 60px rgba(0, 0, 0, 0.6),
              0 0 40px rgba(0, 240, 255, 0.08);
}

.panel-head h1 {
  margin: 0;
  font-size: 1.35rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--neon);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.7), 0 0 22px rgba(0, 240, 255, 0.4);
}
.panel-head .dot { color: var(--neon2); text-shadow: 0 0 10px var(--neon2); }
.panel-head .sub { color: var(--text); font-weight: 500; letter-spacing: 0.06em; text-shadow: none; }
.tagline { margin: 8px 0 20px; color: var(--muted); font-size: 0.9rem; }

.rows { display: flex; flex-direction: column; gap: 12px; }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  border-radius: 16px;
  transition: border-color 0.25s, box-shadow 0.25s, transform 0.2s;
}
.row:hover {
  border-color: rgba(0, 240, 255, 0.45);
  box-shadow: 0 0 18px rgba(0, 240, 255, 0.15);
  transform: translateY(-1px);
}
.row-info { display: flex; flex-direction: column; gap: 2px; }
.row-name { font-weight: 700; letter-spacing: 0.1em; }
.row-desc { font-size: 0.78rem; color: var(--muted); }

.row-disabled { opacity: 0.5; }
.row-disabled:hover { transform: none; box-shadow: none; border-color: var(--border); }

.switch { position: relative; display: inline-block; width: 56px; height: 30px; flex-shrink: 0; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute;
  inset: 0;
  cursor: pointer;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--border);
  border-radius: 999px;
  transition: background 0.3s, box-shadow 0.3s, border-color 0.3s;
}
.slider::before {
  content: "";
  position: absolute;
  height: 22px;
  width: 22px;
  left: 3px;
  top: 3px;
  background: #cfcdf0;
  border-radius: 50%;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s, box-shadow 0.3s;
}
.switch input:checked + .slider {
  background: linear-gradient(90deg, rgba(0, 240, 255, 0.35), rgba(255, 43, 214, 0.35));
  border-color: var(--neon);
  box-shadow: 0 0 14px rgba(0, 240, 255, 0.55);
}
.switch input:checked + .slider::before {
  transform: translateX(26px);
  background: #fff;
  box-shadow: 0 0 10px var(--neon);
}
.switch input:disabled + .slider { cursor: not-allowed; }
.switch input:focus-visible + .slider { outline: 2px solid var(--neon); outline-offset: 2px; }

.reset-btn {
  width: 100%;
  margin-top: 20px;
  padding: 14px;
  font: inherit;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--text);
  background: linear-gradient(90deg, rgba(0, 240, 255, 0.15), rgba(255, 43, 214, 0.15));
  border: 1px solid var(--neon2);
  border-radius: 14px;
  cursor: pointer;
  transition: box-shadow 0.25s, transform 0.15s;
}
.reset-btn:hover { box-shadow: 0 0 22px rgba(255, 43, 214, 0.5); }
.reset-btn:active { transform: scale(0.98); }

.status {
  margin-top: 14px;
  min-height: 1.2em;
  text-align: center;
  font-size: 0.85rem;
  color: var(--neon);
}
.status.error { color: #ff6b8a; }

.chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 18px; }
.chip {
  padding: 6px 12px;
  font-size: 0.72rem;
  color: var(--muted);
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border);
  border-radius: 999px;
}

@media (max-width: 420px) {
  .panel { padding: 20px 16px; border-radius: 18px; }
  .panel-head h1 { font-size: 1.1rem; }
}
